root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
max_line_length = 100
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

[*.{csproj,props,targets,xml,config}]
indent_style = space
indent_size = 2
max_line_length = 100
